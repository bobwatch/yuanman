<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="闪电记账"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_quick_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="8月 · 0笔"
            android:textColor="@color/widget_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="本月已支出"
        android:textColor="@color/widget_muted"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_quick_amount"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="¥0.00"
        android:textColor="@color/widget_text"
        android:textSize="23sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_quick_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_expense_button"
            android:contentDescription="快速记支出"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="＋ 支出"
            android:textColor="@color/widget_orange"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_quick_income"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_income_button"
            android:contentDescription="快速记收入"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="＋ 收入"
            android:textColor="@color/widget_green"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
