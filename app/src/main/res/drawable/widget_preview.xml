<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面 Widget 选择器预览图：模拟真实布局（标题条/金额/副行/加号圆钮） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_background" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <item
        android:width="64dp"
        android:height="8dp"
        android:gravity="top|start"
        android:left="16dp"
        android:top="16dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_primary" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <item
        android:width="104dp"
        android:height="16dp"
        android:gravity="top|start"
        android:left="16dp"
        android:top="32dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_text" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <item
        android:width="80dp"
        android:height="8dp"
        android:gravity="top|start"
        android:left="16dp"
        android:top="56dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_text_secondary" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <item
        android:width="32dp"
        android:height="32dp"
        android:gravity="center_vertical|end"
        android:right="16dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_primary" />
        </shape>
    </item>
</layer-list>
