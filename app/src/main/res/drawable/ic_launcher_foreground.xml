<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面启动图标前景：高美学对称圆满环与双层翡翠水韵 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 剪裁为完美居中正圆 (中心 54, 54，半径 25) -->
    <group>
        <clip-path android:pathData="M29,54 a25,25 0 1,0 50,0 a25,25 0 1,0 -50,0" />

        <!-- 底层柔和深层水波 (半透明微澜) -->
        <path
            android:fillColor="#5EEAD4"
            android:fillAlpha="0.45"
            android:pathData="M27,54 C35,58 45,58 54,54 C63,50 73,50 81,54 L85,85 L25,85 Z" />

        <!-- 表层明亮生机水波 (主体水面) -->
        <path
            android:fillColor="#A7F3D0"
            android:pathData="M27,54 C35,50 45,50 54,54 C63,58 73,58 81,54 L85,85 L25,85 Z" />
    </group>

    <!-- 居中圆满白环 (圆满象征，线条纯粹饱满) -->
    <path
        android:pathData="M29,54 a25,25 0 1,0 50,0 a25,25 0 1,0 -50,0"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
