<?xml version="1.0" encoding="utf-8"?>
<!-- 沅满·旗舰级桌面启动图标前景：纯白圆满环 + 透光水韵微澜 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 剪裁为完美居中正圆 (中心 54, 54，半径 25) -->
    <group>
        <clip-path android:pathData="M29,54 a25,25 0 1,0 50,0 a25,25 0 1,0 -50,0" />

        <!-- 深层水韵：纯白 25% 半透光影 -->
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.22"
            android:pathData="M27,55 C35,51 45,51 54,55 C63,59 73,59 81,55 L85,85 L25,85 Z" />

        <!-- 浅层水波：纯白 60% 润泽波澜 -->
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.60"
            android:pathData="M27,55 C35,59 45,59 54,55 C63,51 73,51 81,55 L85,85 L25,85 Z" />
    </group>

    <!-- 纯白圆满外环 (纯粹利落，质感饱满) -->
    <path
        android:pathData="M29,54 a25,25 0 1,0 50,0 a25,25 0 1,0 -50,0"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
