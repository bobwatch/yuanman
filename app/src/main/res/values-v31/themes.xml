<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+ 系统启动画面：品牌蓝底 + logo 动画，时长与 31 以下 windowBackground 展示衔接。 -->
    <style name="Theme.Yuanman" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/splash_blue</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:windowSplashScreenBackground">@color/splash_blue</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowSplashScreenAnimationDuration">500</item>
    </style>
</resources>
